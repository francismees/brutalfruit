# Supabase — Get from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — transactional + comms email (https://resend.com/api-keys)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=brunch@brutalfruit.co.tz

# Milan Brunch dashboard — comma-separated emails allowed into /dashboard
DASHBOARD_ALLOWED_EMAILS=you@brutalfruit.co.tz,teammate@brutalfruit.co.tz

# Absolute base URL used in email links & ICS files
NEXT_PUBLIC_SITE_URL=https://brutalfruit.co.tz
